{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NotificationSchedulesAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:781540302423:table/CashSense-NotificationSchedules"
    },
    {
      "Sid": "CleanupLegacyRules",
      "Effect": "Allow",
      "Action": [
        "events:RemoveTargets",
        "events:DeleteRule"
      ],
      "Resource": "arn:aws:events:us-east-1:781540302423:rule/CashSense*"
    },
    {
      "Sid": "RemovePushInvokePermission",
      "Effect": "Allow",
      "Action": "lambda:RemovePermission",
      "Resource": "arn:aws:lambda:us-east-1:781540302423:function:CashSense-PushSender"
    }
  ]
}
