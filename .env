# Local placeholder .env for iOS asset bundling.
# Replace values with real credentials and DO NOT commit secrets.

# Cognito (placeholder values — replace with real credentials)
COGNITO_USER_POOL_ID=us-east-1_i8OdXtL1u
COGNITO_CLIENT_ID=2fep4tchr2g6olsbs9nj7nd4u4
COGNITO_REGION=us-east-1
# Optional: required for Amplify S3 uploads in many setups
COGNITO_IDENTITY_POOL_ID=

# AWS
AWS_REGION=us-east-1
S3_BUCKET=arn:aws:s3:::cashsense-assets
