ALLOW_TEST_ACCOUNT_SYNC=true

# SNS
# Android (example placeholder)
SNS_ANDROID_ARN=
# iOS — sandbox and production ARNs
SNS_IOS_ARN_SANDBOX=arn:aws:sns:us-east-1:781540302423:app/APNS_SANDBOX/CashSense-iOS-Sandbox
SNS_IOS_ARN_PRODUCTION=arn:aws:sns:us-east-1:781540302423:app/APNS/CashSense-iOS

# Firebase / other
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# API Gateway
