<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CashSenseWidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="CashSenseWidgetRowIcon">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_marginEnd">9dp</item>
        <item name="android:background">@drawable/cashsense_widget_row_icon_background</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:padding">6dp</item>
    </style>
    <style name="CashSenseWidgetName">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">#FF212121</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="CashSenseWidgetValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FF616161</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
