{
  "RoleName": "CashSense-BackupRole",
  "PolicyName": "CashSenseBackupInline",
  "PolicyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "BackupsMetadataTable",
        "Effect": "Allow",
        "Action": [
          "dynamodb:PutItem",
          "dynamodb:UpdateItem",
          "dynamodb:Query",
          "dynamodb:DeleteItem"
        ],
        "Resource": "arn:aws:dynamodb:us-east-1:781540302423:table/CashSense-Backups"
      },
      {
        "Sid": "UsersPremiumLookup",
        "Effect": "Allow",
        "Action": "dynamodb:GetItem",
        "Resource": "arn:aws:dynamodb:us-east-1:781540302423:table/CashSense-Users"
      },
      {
        "Sid": "BackupsBucketObjects",
        "Effect": "Allow",
        "Action": [
          "s3:PutObject",
          "s3:GetObject",
          "s3:DeleteObject"
        ],
        "Resource": "arn:aws:s3:::cashsense-backups-prod/backups/*"
      }
    ]
  }
}