{
  "Version": "2012-10-17",
  "Statement": [
    { "Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:ConditionCheckItem", "dynamodb:Scan"], "Resource": ["REPLACE_WITH_USERS_TABLE_ARN", "REPLACE_WITH_CLAIMS_TABLE_ARN", "REPLACE_WITH_APPLE_EVENTS_TABLE_ARN"] },
    { "Effect": "Allow", "Action": ["secretsmanager:GetSecretValue"], "Resource": ["REPLACE_WITH_APPLE_SECRET_ARN", "REPLACE_WITH_GOOGLE_SECRET_ARN"] }
  ]
}
